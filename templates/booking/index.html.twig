{% extends 'base.html.twig' %}

{% block title %}Book a Gaming Station - Gamora's Gaming Cafe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="booking-page-wrapper">
        <main class="booking-container-main">
            <header class="booking-header booking-page-header">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="back-home-btn">← Back to admin area</a>
                {% elseif is_granted('ROLE_STAFF') %}
                    <a href="{{ path('staff_dashboard') }}" class="back-home-btn">← Back to staff area</a>
                {% else %}
                    <a href="{{ path('app_home') }}" class="back-home-btn">← Back to home</a>
                {% endif %}
                <p class="booking-step-label">YOUR SESSION · STEP 1 OF 2</p>
                <h1>Book Your <span class="cyan-text">Gaming Station</span></h1>
                <p class="booking-intro">Pick your station, choose a start time, and select how long you want to play.</p>
            </header>

            {{ form_start(bookingForm, {'attr': {'id': 'bookingForm'}}) }}
                {% if form_errors(bookingForm) %}
                    <div class="booking-form-errors" role="alert">{{ form_errors(bookingForm) }}</div>
                {% endif %}

                <div id="selectionStep">
                    <section class="device-section">
                        <div class="booking-section-heading">
                            <div>
                                <p class="booking-step-label">01 · STATION</p>
                                <h2 class="section-title">Choose your station</h2>
                            </div>
                            <span class="booking-hint">Select one to continue</span>
                        </div>

                        {% if stations is empty %}
                            <p class="booking-empty-state">No stations are available right now. Please check back later or ask staff.</p>
                        {% else %}
                            <div class="device-grid" id="stationGrid">
                                {% for station in stations %}
                                    {% set stationType = station.type|default('Station') %}
                                    {% set isConsole = 'console' in stationType|lower %}
                                    {% set imageFile = station.img ?: (isConsole ? 'ps5.png' : 'pc.png') %}
                                    {% set fallbackImage = isConsole ? 'ps5.png' : 'pc.png' %}
                                    <button
                                        type="button"
                                        class="device-card"
                                        data-station-id="{{ station.id }}"
                                        data-station-name="{{ station.name }}"
                                        data-station-type="{{ stationType }}"
                                        aria-pressed="false"
                                    >
                                        <span class="station-img-box">
                                            <img
                                                src="{{ asset('image_GamingCafe/' ~ imageFile) }}"
                                                alt=""
                                                class="device-img"
                                                onerror="this.src='{{ asset('image_GamingCafe/' ~ fallbackImage) }}'"
                                            >
                                        </span>
                                        <span class="station-name">{{ station.name }}</span>
                                        <span class="station-type-label">{{ stationType }}</span>
                                        <span class="spec-container">
                                            {% if station.gpu %}<span class="spec-tag">{{ station.gpu }}</span>{% endif %}
                                            {% if station.cpu %}<span class="spec-tag">{{ station.cpu }}</span>{% endif %}
                                            {% if station.hz %}<span class="spec-tag">{{ station.hz }} Hz</span>{% endif %}
                                        </span>
                                        <span class="select-btn">Select station</span>
                                    </button>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="booking-field-error">{{ form_errors(bookingForm.station) }}</div>
                        <div class="visually-hidden">{{ form_widget(bookingForm.station, {'id': 'stationInput'}) }}</div>
                    </section>

                    <section class="datetime-section">
                        <div class="booking-section-heading">
                            <div>
                                <p class="booking-step-label">02 · DATE & TIME</p>
                                <h2 class="section-title">When are you coming?</h2>
                            </div>
                        </div>
                        <div class="datetime-grid">
                            <div class="input-group">
                                {{ form_label(bookingForm.bookingDate, 'Booking date') }}
                                {{ form_widget(bookingForm.bookingDate, {'id': 'bookingDate', 'attr': {'class': 'custom-input', 'min': today}}) }}
                                {{ form_errors(bookingForm.bookingDate) }}
                            </div>
                            <div class="input-group">
                                {{ form_label(bookingForm.startTime, 'Start time') }}
                                {{ form_widget(bookingForm.startTime, {'id': 'bookingTime', 'attr': {'class': 'custom-input', 'step': 900}}) }}
                                {{ form_errors(bookingForm.startTime) }}
                            </div>
                        </div>
                    </section>

                    <section class="time-section">
                        <div class="booking-section-heading">
                            <div>
                                <p class="booking-step-label">03 · DURATION</p>
                                <h2 class="section-title">How long do you want to play?</h2>
                            </div>
                            <span class="booking-hint">1 to 12 hours</span>
                        </div>
                        <div class="duration-picker">
                            <button type="button" class="duration-stepper" id="minusBtn" aria-label="Remove one hour">−</button>
                            {{ form_widget(bookingForm.hours, {'id': 'hoursInput', 'attr': {'class': 'duration-input', 'min': 1, 'max': 12}}) }}
                            <button type="button" class="duration-stepper" id="plusBtn" aria-label="Add one hour">+</button>
                            <span class="duration-unit">hours</span>
                        </div>
                        {{ form_errors(bookingForm.hours) }}
                        <div class="duration-presets" aria-label="Quick duration choices">
                            {% for duration in [1, 2, 3, 4, 5, 6, 8, 12] %}
                                <button type="button" class="duration-preset{% if duration == 1 %} is-active{% endif %}" data-hours="{{ duration }}">{{ duration }}h</button>
                            {% endfor %}
                        </div>
                    </section>

                    <section class="price-summary-card booking-price-card">
                        <div>
                            <p class="booking-step-label">ESTIMATED TOTAL</p>
                            <p class="booking-price-caption"><span id="tierDisplay">BASIC</span> · updates with your station and duration</p>
                        </div>
                        <strong class="price-value highlight-price" id="priceDisplay">Select a station</strong>
                    </section>

                    <div class="booking-step-actions">
                        <span id="selectionError" class="booking-inline-error" role="alert"></span>
                        <button type="button" class="review-btn" id="reviewBookingBtn">Review booking <span aria-hidden="true">→</span></button>
                    </div>
                </div>

                <section id="reviewStep" class="booking-review-step" hidden>
                    <p class="booking-step-label">YOUR SESSION · STEP 2 OF 2</p>
                    <h2 class="section-title">Review & payment</h2>
                    <p class="booking-intro">Check your details, choose a payment method, then confirm.</p>

                    <div class="summary-card booking-summary-card">
                        <div class="summary-row"><span class="summary-label">Station</span><strong class="summary-value" id="sumStation">—</strong></div>
                        <div class="summary-row"><span class="summary-label">Type</span><strong class="summary-value" id="sumType">—</strong></div>
                        <div class="summary-row"><span class="summary-label">Date</span><strong class="summary-value" id="sumDate">—</strong></div>
                        <div class="summary-row"><span class="summary-label">Start time</span><strong class="summary-value" id="sumTime">—</strong></div>
                        <div class="summary-row"><span class="summary-label">Duration</span><strong class="summary-value" id="sumDuration">—</strong></div>
                        <div class="summary-row"><span class="summary-label">Tier</span><strong class="summary-value" id="sumTier">—</strong></div>
                        <div class="summary-row booking-total-row"><span class="summary-label">Total</span><strong class="summary-value highlight-price" id="sumPrice">—</strong></div>
                    </div>

                    <div class="input-group payment-method-group">
                        {{ form_label(bookingForm.paymentMethod, 'Payment method') }}
                        {{ form_widget(bookingForm.paymentMethod, {'id': 'paymentMethod', 'attr': {'class': 'custom-input'}}) }}
                        {{ form_errors(bookingForm.paymentMethod) }}
                        <p class="payment-demo-note" id="paymentNote">Cash bookings are saved as pending payment. GCash and Maya are demo-only; no real charge is made.</p>
                    </div>

                    <div class="booking-step-actions booking-review-actions">
                        <button type="button" class="btn-secondary" id="backToEditBtn">← Change details</button>
                        <button type="submit" class="review-btn" id="confirmBookingBtn">Confirm booking</button>
                    </div>
                </section>
            {{ form_end(bookingForm) }}
        </main>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('booking.js') }}" defer></script>
{% endblock %}
