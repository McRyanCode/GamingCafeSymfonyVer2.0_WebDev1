{% extends 'base.html.twig' %}

{% block title %}Select Your Station & Time - Gaming Cafe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('booking.css') }}">
    <style>
        body {
            background-color: #0a0c14 !important;
            color: #fff !important;
            padding-bottom: 140px !important;
        }
        .custom-input {
            background: rgba(10, 12, 20, 0.8) !important;
            border: 1px solid rgba(0, 245, 212, 0.3) !important;
            color: #fff !important;
            padding: 12px 14px !important;
            border-radius: 6px !important;
            outline: none !important;
            width: 100% !important;
            box-sizing: border-box;
        }
        .custom-input:focus {
            border-color: #00f5d4 !important;
            box-shadow: 0 0 10px rgba(0, 245, 212, 0.3) !important;
        }
        .device-card.selected {
            border-color: #00f5d4 !important;
            background: rgba(0, 245, 212, 0.08) !important;
            box-shadow: 0 0 20px rgba(0, 245, 212, 0.3) !important;
        }
        .device-card.selected .select-btn {
            background: #00f5d4 !important;
            color: #0a0c14 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <header class="booking-header">
        <a href="{{ path('app_home') }}" class="back-link" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: rgba(0, 245, 212, 0.08); border: 1px solid rgba(0, 245, 212, 0.3); color: #00f5d4; text-decoration: none; font-weight: 600; font-size: 14px; border-radius: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back to Home
        </a>    
        <h1 style="text-align: center; width: 100%;">Select Your <span style="color: #00f5d4;">Station</span></h1>    
    </header>

    <main class="booking-container">
        {{ form_start(bookingForm, {'attr': {'id': 'symfonyBookingForm'}}) }}

            <!-- SELECTION VIEW -->
            <div id="selectionStep">
                
                <!-- PC SECTION -->
                <section class="device-section">
                    <h2 class="section-title">Gaming PCs</h2>
                    <div class="device-grid" id="pcGrid">
                        
                        <div class="device-card" data-device-id="PC-01" data-device-type="PC" data-device-name="PC 01" onclick="selectCardData(this, 'PC 01', 'Pro Gaming Rig', 80)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/pc.png') }}" alt="PC 01" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">PC 01</h3>
                            <div class="spec-container">
                                <span class="spec-tag">RTX 4070</span>
                                <span class="spec-tag">i7-13700K</span>
                                <span class="spec-tag">240Hz</span>
                            </div>
                            <button type="button" class="select-btn">Select PC 01</button>
                        </div>

                        <div class="device-card" data-device-id="PC-02" data-device-type="PC" data-device-name="PC 02" onclick="selectCardData(this, 'PC 02', 'Pro Gaming Rig', 80)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/pc2.png') }}" alt="PC 02" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">PC 02</h3>
                            <div class="spec-container">
                                <span class="spec-tag">RTX 4070</span>
                                <span class="spec-tag">i7-13700K</span>
                                <span class="spec-tag">240Hz</span>
                            </div>
                            <button type="button" class="select-btn">Select PC 02</button>
                        </div>

                        <div class="device-card" data-device-id="PC-03" data-device-type="PC" data-device-name="PC 03" onclick="selectCardData(this, 'PC 03', 'Standard Rig', 60)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/ps3.png') }}" alt="PC 03" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1612287233202-b51a36616763?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">PC 03</h3>
                            <div class="spec-container">
                                <span class="spec-tag">RTX 3060</span>
                                <span class="spec-tag">i5-12400F</span>
                                <span class="spec-tag">144Hz</span>
                            </div>
                            <button type="button" class="select-btn">Select PC 03</button>
                        </div>

                        <div class="device-card" data-device-id="PC-04" data-device-type="PC" data-device-name="PC 04" onclick="selectCardData(this, 'PC 04', 'Standard Rig', 60)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/pc4.png') }}" alt="PC 04" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">PC 04</h3>
                            <div class="spec-container">
                                <span class="spec-tag">RTX 3060</span>
                                <span class="spec-tag">i5-12400F</span>
                                <span class="spec-tag">144Hz</span>
                            </div>
                            <button type="button" class="select-btn">Select PC 04</button>
                        </div>

                        <div class="device-card" data-device-id="PC-05" data-device-type="PC" data-device-name="PC 05" onclick="selectCardData(this, 'PC 05', 'Standard Rig', 60)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/pc.png') }}" alt="PC 05" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">PC 05</h3>
                            <div class="spec-container">
                                <span class="spec-tag">RTX 3060</span>
                                <span class="spec-tag">i5-12400F</span>
                                <span class="spec-tag">144Hz</span>
                            </div>
                            <button type="button" class="select-btn">Select PC 05</button>
                        </div>

                        <div class="device-card" data-device-id="PC-06" data-device-type="PC" data-device-name="PC 06" onclick="selectCardData(this, 'PC 06', 'Standard Rig', 60)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/pc7.png') }}" alt="PC 06" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1612287233202-b51a36616763?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">PC 06</h3>
                            <div class="spec-container">
                                <span class="spec-tag">RTX 3060</span>
                                <span class="spec-tag">i5-12400F</span>
                                <span class="spec-tag">144Hz</span>
                            </div>
                            <button type="button" class="select-btn">Select PC 06</button>
                        </div>

                    </div>
                </section>

                <!-- CONSOLE SECTION -->
                <section class="device-section">
                    <h2 class="section-title">Consoles</h2>
                    <div class="device-grid" id="consoleGrid">
                        
                        <div class="device-card" data-device-id="Console-01" data-device-type="Console" data-device-name="Console 01" onclick="selectCardData(this, 'Console 01', 'VIP Ultra Rig', 100)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/ps5.png') }}" alt="Console 01" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1606813907291-d86efa9b94db?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">Console 01</h3>
                            <div class="spec-container">
                                <span class="spec-tag">PS5</span>
                                <span class="spec-tag">4K OLED TV</span>
                                <span class="spec-tag">2 Controllers</span>
                            </div>
                            <button type="button" class="select-btn">Select Console 01</button>
                        </div>

                        <div class="device-card" data-device-id="Console-02" data-device-type="Console" data-device-name="Console 02" onclick="selectCardData(this, 'Console 02', 'VIP Ultra Rig', 100)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/swtch.png') }}" alt="Console 02" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1606813907291-d86efa9b94db?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">Console 02</h3>
                            <div class="spec-container">
                                <span class="spec-tag">SWITCH 2</span>
                                <span class="spec-tag">4K OLED TV</span>
                                <span class="spec-tag">2 Controllers</span>
                            </div>
                            <button type="button" class="select-btn">Select Console 02</button>
                        </div>

                        <div class="device-card" data-device-id="Console-03" data-device-type="Console" data-device-name="Console 03" onclick="selectCardData(this, 'Console 03', 'VIP Ultra Rig', 100)">
                            <div class="station-img-box">
                                <img src="{{ asset('image_GamingCafe/Xbox.png') }}" alt="Console 03" class="device-img" onerror="this.src='https://images.unsplash.com/photo-1606813907291-d86efa9b94db?auto=format&fit=crop&w=600&q=80'">
                            </div>
                            <h3 class="station-name">Console 03</h3>
                            <div class="spec-container">
                                <span class="spec-tag">Xbox Series X</span>
                                <span class="spec-tag">4K TV</span>
                                <span class="spec-tag">2 Controllers</span>
                            </div>
                            <button type="button" class="select-btn">Select Console 03</button>
                        </div>

                    </div>
                </section>

                <!-- DATE & TIME SELECTION SECTION (Using Copilot's fixed bookingDate & startTime) -->
                <section class="datetime-section">
                    <h2 class="section-title">Select Date & Start Time</h2>
                    <div class="datetime-grid">
                        <div class="input-group">
                            <label for="bookingDate">Booking Date:</label>
                            {{ form_widget(bookingForm.bookingDate, {'attr': {'class': 'custom-input', 'id': 'bookingDate'}}) }}
                        </div>
                        <div class="input-group">
                            <label for="bookingTime">Start Time:</label>
                            {{ form_widget(bookingForm.startTime, {'attr': {'class': 'custom-input', 'id': 'bookingTime'}}) }}
                        </div>
                    </div>
                </section>

                <!-- DURATION & TIME SELECTION SECTION -->
                <section class="time-section">
                    <h2 class="section-title">Select Duration</h2>
                    
                    <div class="time-mode-selector">
                        <label class="mode-option">
                            <input type="radio" name="timeMode" value="Fixed" checked>
                            <span class="mode-card">
                                <strong>Fixed Time</strong>
                                <small>Specify exact hours</small>
                            </span>
                        </label>
                    </div>

                    <div class="fixed-hours-wrapper" id="fixedHoursWrapper">
                        <p class="label-text">Select Number of Hours:</p>
                        <div class="counter-box">
                            <button type="button" class="counter-btn" onclick="adjustHours(-1)">-</button>
                            {{ form_widget(bookingForm.hours, {'attr': {'id': 'hoursInput', 'value': '1'}}) }}
                            <button type="button" class="counter-btn" onclick="adjustHours(1)">+</button>
                        </div>
                    </div>
                </section>

                <!-- PRICING REVIEW DISPLAY CARD -->
                <section class="price-summary-card">
                    <h2 class="section-title">Pricing Breakdown</h2>
                    <div class="price-details-grid" style="display: flex; justify-content: space-between;">
                        <div class="price-item">
                            <span class="price-label">Pricing Tier:</span>
                            <span class="price-value tier-badge" id="tierDisplay">BASIC</span>
                            {{ form_widget(bookingForm.tier, {'attr': {'style': 'display:none;', 'id': 'hiddenTierInput'}}) }}
                        </div>
                        <div class="price-item">
                            <span class="price-label">Estimated Price:</span>
                            <span class="price-value highlight-price" id="priceDisplay">₱40</span>
                        </div>
                    </div>
                </section>

            </div>

            <!-- HIDDEN STATION FIELD FOR SYMFONY -->
            <div style="display:none;">
                {{ form_widget(bookingForm.station, {'id': 'hiddenStationInput'}) }}
            </div>

            <!-- Current Selection Status Bar -->
            <div class="selection-bar" id="selectionBar">
                <div class="summary-details">
                    <span>Station: <strong id="selectedDeviceText">None</strong></span>
                    <span class="divider">|</span>
                    <span>Time: <strong id="selectedTimeText">1 Hour(s) (Fixed)</strong></span>
                    <span class="divider">|</span>
                    <span>Total: <strong id="barPriceText">₱0</strong></span>
                </div>
                <button type="submit" class="review-btn" id="reviewBookingBtn">Review & Proceed →</button>
            </div>

        {{ form_end(bookingForm) }}
    </main>

    <script>
        let currentHours = 1;
        let hourlyRate = 40;

        function selectCardData(cardElement, deviceName, tierName, rate) {
            document.querySelectorAll('.device-card').forEach(c => c.classList.remove('selected'));
            cardElement.classList.add('selected');

            hourlyRate = rate;
            document.getElementById('selectedDeviceText').innerText = deviceName;
            document.getElementById('hiddenStationInput').value = deviceName;
            document.getElementById('tierDisplay').innerText = tierName;
            document.getElementById('hiddenTierInput').value = tierName;
            updateTotal();
        }

        function adjustHours(change) {
            currentHours += change;
            if (currentHours < 1) currentHours = 1;
            if (currentHours > 12) currentHours = 12;

            document.getElementById('hoursInput').value = currentHours;
            document.getElementById('selectedTimeText').innerText = currentHours + ' Hour(s) (Fixed)';
            updateTotal();
        }

        function updateTotal() {
            let total = currentHours * hourlyRate;
            document.getElementById('priceDisplay').innerText = '₱' + total;
            document.getElementById('barPriceText').innerText = '₱' + total;
        }
    </script>
{% endblock %}