{% extends 'base.html.twig' %}

{% block title %}Gamora's Gaming Cafe{% endblock %}

{% block body %}
<!-- Hero Container with Embedded Scalable Image -->
<div class="hero-wrapper">
    <!-- Fixed Navigation Bar -->
    <header class="site-header">
        <div class="nav-container">
            <a href="#home" class="brand-logo">
                <img src="{{ asset('image_GamingCafe/Logo.png') }}" alt="Gamora's Gaming Cafe">
            </a>

            <nav class="nav-links">
                <a href="#hero">HOME</a>
                <a href="#">PCs</a>
                <a href="#pricing">RATES</a>
                <a href="#events">EVENTS</a>
                <a href="#contact">CONTACT</a>
                <a href="#about">ABOUT US</a>
                
                <!-- Auth Controls Wrapper -->
                <div class="nav-auth-container">
                    <!-- Shown when Logged Out -->
                    <div id="loggedOutNav" class="auth-btn-group">
                        <button id="openSignInBtn" class="btn-nav">Sign In</button> 
                        <button id="openSignUpBtn" class="btn-nav-primary">Sign Up</button> 
                    </div>

                    <!-- Shown when Logged In (Hidden by default for now) -->
                    <div id="loggedInNav" class="user-profile-wrapper" style="display: none;">
                        <button id="profileMenuBtn" class="profile-avatar-btn">
                            <img src="{{ asset('image_GamingCafe/profile.png') }}" alt="Profile Avatar" class="user-avatar">
                        </button>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Hero Body -->
    <div id="hero" class="hero-body">
        <div class="hero-container">
            <div class="hero-content">
                <h1>WHERE<br><span class="cyan-text">CHAMPIONS</span> ARE BORN.</h1>
                
                <div class="hero-buttons">
                    <a href="#pricing" class="custom-hero-btn custom-primary-btn">BOOK NOW</a>
                    <a href="#pricing" class="custom-hero-btn custom-secondary-btn">VIEW RATES</a>
                </div>
            </div>
        </div>
    </div>
</div>






<!-- Why Choose Us Section -->
<section class="why-choose-us">
    <div id="why-choose" class="why-choose-container">

        <!-- Left Column: Title & Feature Capsules -->
        <div class="why-choose-content">
            <h2><span style="color:#000000">WHY</span> <span style="color:#00d2ff">CHOOSE</span> <span style="color:#000000">US ?</span></h2>
            
            <ul class="feature-pills">
                <li><span class="bullet">•</span> RTX Gaming PCs</li>
                <li><span class="bullet">•</span> Gaming Consoles</li>
                <li><span class="bullet">•</span> Fast Fiber Internet</li>
                <li><span class="bullet">•</span> Tournaments & Events</li>
            </ul>
        </div>

        <!-- Right Column: 4 Separate Device Images Grouped Together -->
        <div class="why-choose-media">
            <div class="devices-cluster">
                <img src="{{ asset('image_GamingCafe/pc.png') }}" class="device device-1" alt="Gaming PC">
                <img src="{{ asset('image_GamingCafe/Xbox.png') }}" class="device device-2" alt="Xbox Console">
                <img src="{{ asset('image_GamingCafe/PS5.png') }}" class="device device-3" alt="PS5 Console">
                <img src="{{ asset('image_GamingCafe/swtch.png') }}" class="device device-4" alt="Nintendo Switch">
            </div>
        </div>

    </div>
</section>







<!-- Featured Games Section -->
<section class="news">
    <div id="games" class="news-container">
        <div class="news-header">
            <h2>FEATURED <span class="cyan-text">GAMES</span></h2>
            <div class="carousel-nav-buttons">
                <button id="scrollLeft" class="carousel-btn" aria-label="Scroll Left">❮</button>
                <button id="scrollRight" class="carousel-btn" aria-label="Scroll Right">❯</button>
            </div>
        </div>

        <!-- Horizontal Scrolling Carousel Container -->
        <div class="games-carousel" id="gamesCarousel">
            <div class="game-card">
                <img src="{{ asset('image_GamingCafe/valorant.jpg') }}" alt="Valorant">
                <div class="game-info">
                    <h3>Valorant</h3>
                    <p>Tactical Shooter</p>
                </div>
            </div>
            <div class="game-card">
                <img src="{{ asset('image_GamingCafe/gta.jpg') }}" alt="GTA V">
                <div class="game-info">
                    <h3>GTA V</h3>
                    <p>Open World</p>
                </div>
            </div>
            <div class="game-card">
                <img src="{{ asset('image_GamingCafe/tekken.jpg') }}" alt="Tekken 8">
                <div class="game-info">
                    <h3>Tekken 8</h3>
                    <p>Fighting</p>
                </div>
            </div>
            <div class="game-card">
                <img src="{{ asset('image_GamingCafe/dota.jpg') }}" alt="Dota 2">
                <div class="game-info">
                    <h3>Dota 2</h3>
                    <p>MOBA</p>
                </div>
            </div>
            <div class="game-card">
                <img src="{{ asset('image_GamingCafe/cyberpunk.jpg') }}" alt="Cyberpunk 2077">
                <div class="game-info">
                    <h3>Cyberpunk 2077</h3>
                    <p>RPG Action</p>
                </div>
            </div>
        </div>
    </div>
</section>







<!-- Pricing Review Section -->
<section id="pricing" class="pricing-review-section">
    <div class="pricing-review-container">
        <h2 class="pricing-title">
            <span class="cyan-text">PRICING</span> REVIEW
        </h2>

        <div class="pricing-cards-wrapper">
            <!-- BASIC CARD -->
            <div class="pricing-card">
                <h3 class="card-plan-title">BASIC</h3>
                <p class="card-duration">1 HOUR</p>
                <div class="card-amount">₱40</div>
                <button class="reserve-btn">RESERVE NOW</button>
            </div>

            <!-- STANDARD CARD -->
            <div class="pricing-card">
                <h3 class="card-plan-title">STANDARD</h3>
                <p class="card-duration">3 HOURS</p>
                <div class="card-amount">₱100</div>
                <button class="reserve-btn">RESERVE NOW</button>
            </div>

            <!-- PREMIUM CARD -->
            <div class="pricing-card">
                <h3 class="card-plan-title">PREMIUM</h3>
                <p class="card-duration">5 HOURS</p>
                <div class="card-amount">₱150</div>
                <button class="reserve-btn">RESERVE NOW</button>
            </div>
        </div>
    </div>
</section>




<!-- Events & Tournaments Section -->
<section id="events" class="events-section">
    <div class="events-container">
        
        <!-- Left Column: Content -->
        <div class="events-content">
            <h2 class="events-title">
                PROVE YOUR <span class="cyan-text">SKILLS</span>
            </h2>
            <p class="events-description">
                Join exciting tournaments, community events, and friendly competitions. Compete, showcase your skills, and win amazing prizes while connecting with fellow gamers.
            </p>
            <a href="#events-list" class="view-events-btn">VIEW EVENTS</a>
        </div>

        <!-- Right Column: Media -->
        <div class="events-media">
            <img src="{{ asset('image_GamingCafe/event.png') }}" alt="Gamora Gaming Tournament Trophy Celebration" class="events-image">
        </div>

    </div>
</section>





<!-- Visit Us Section -->
<section id="contact" class="visit-us-section">
    <div class="visit-us-container">
        
        <!-- Left Column: Map Image -->
        <div class="visit-us-media">
            <img src="{{ asset('image_GamingCafe/map.png') }}" alt="Gamora's Gaming Cafe Location Map" class="visit-map-image">
        </div>

        <!-- Right Column: Details -->
        <div class="visit-us-content">
            <h2 class="visit-title">Visit Us</h2>
            <div class="visit-details">
                <h3 class="cafe-name">Gamora's Gaming Cafe</h3>
                <p class="cafe-address">123 Gamer Street, Barangay Central,<br>Guihulngan City, Negros Oriental</p>
                <p class="cafe-phone">(123) 456-7890</p>
                <p class="cafe-hours">Open Daily: 10:00 AM – 12:00 AM</p>
            </div>
        </div>

    </div>
</section>





<!-- About Us & Footer Section -->
<footer id="about" class="about-footer-section">
    
    <!-- About Us Subsection -->
    <div class="about-container">
        <div class="about-content">
            <h2 class="about-title">| ABOUT US</h2>
            <p class="about-text">
                <span class="cyan-text">Gamora's Gaming Cafe</span> is a modern gaming space where players can enjoy high-performance gaming, connect with friends, and become part of a welcoming gaming community. More than just a place to play, Gamora's Gaming Cafe is designed to provide a comfortable, exciting, and inclusive environment for gamers of all skill levels.
            </p>
        </div>
        <div class="about-media">
            <div class="avatar-card">
                <img src="{{ asset('image_GamingCafe/avatar.png') }}" alt="Gamora Avatar" class="avatar-img">
            </div>
        </div>
    </div>

    <!-- Main Footer Links Subsection -->
    <div class="footer-main">
        <div class="footer-container">
            <!-- Brand Column -->
            <div class="footer-col brand-col">
                <img src="{{ asset('image_GamingCafe/Logo.png') }}" alt="Gamora's Gaming Cafe Logo" class="footer-logo">
            </div>

            <!-- Explore Links -->
            <div class="footer-col">
                <h3>EXPLORE</h3>
                <ul>
                    <li><a href="#home">HOME</a></li>
                    <li><a href="#pcs">PCs</a></li>
                    <li><a href="#pricing">RATES</a></li>
                    <li><a href="#events">EVENTS</a></li>
                    <li><a href="#contact">CONTACT</a></li>
                    <li><a href="#about">ABOUT US</a></li>
                </ul>
            </div>

            <!-- Legal Links -->
            <div class="footer-col">
                <h3>LEGAL</h3>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms & Conditions</a></li>
                </ul>
            </div>

            <!-- Follow Us Links -->
            <div class="footer-col">
                <h3>FOLLOW US</h3>
                <ul>
                    <li><a href="#">Facebook</a></li>
                    <li><a href="#">Instagram</a></li>
                    <li><a href="#">TikTok</a></li>
                    <li><a href="#">Discord</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Footer Bottom Bar -->
    <div class="footer-bottom">
        <div class="footer-bottom-container">
            <p>© 2026 Gamora's Gaming Cafe. All Rights Reserved</p>
            <div class="footer-social-icons">
                <a href="#" aria-label="Discord">d</a>
                <a href="#" aria-label="Facebook">f</a>
                <a href="#" aria-label="Twitter">X</a>
                <a href="#" aria-label="TikTok">T</a>
            </div>
        </div>
    </div>

</footer>

{% endblock %}