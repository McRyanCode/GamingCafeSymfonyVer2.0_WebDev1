{% extends 'base.html.twig' %}

{% block title %}Gamora's Gaming Cafe{% endblock %}

{% block body %}
<section class="hero-wrapper">
    <!-- Header & Navigation Bar -->
    <header class="site-header">
        <div class="nav-container">
            <!-- Brand Logo -->
            <a href="{{ path('app_home') }}" class="brand-logo">
                <img src="{{ asset('image_GamingCafe/logo.png') }}" alt="Gamora's Gaming Cafe Logo">
            </a>

            <!-- Navigation Links (Anchors for smooth scrolling) -->
            <nav class="nav-links">
                <a href="{{ path('app_home') }}">HOME</a>
                <a href="#pcs">PCs</a>
                <a href="#pricing">RATES</a>
                <a href="#events">EVENTS</a>
                <a href="#contact">CONTACT</a>
                <a href="#about">ABOUT US</a>
            </nav>

            <!-- Authentication Controls (Dynamic: Logged In vs Logged Out) -->
