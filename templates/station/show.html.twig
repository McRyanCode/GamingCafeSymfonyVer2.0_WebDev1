{% extends 'base.html.twig' %}

{% block title %}Station{% endblock %}

{% block body %}
    <h1>Station</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ station.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ station.name }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ station.type }}</td>
            </tr>
            <tr>
                <th>Img</th>
                <td>{{ station.img }}</td>
            </tr>
            <tr>
                <th>Gpu</th>
                <td>{{ station.gpu }}</td>
            </tr>
            <tr>
                <th>Cpu</th>
                <td>{{ station.cpu }}</td>
            </tr>
            <tr>
                <th>Hz</th>
                <td>{{ station.hz }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_station_index') }}">back to list</a>

    <a href="{{ path('app_station_edit', {'id': station.id}) }}">edit</a>

    {{ include('station/_delete_form.html.twig') }}
{% endblock %}
