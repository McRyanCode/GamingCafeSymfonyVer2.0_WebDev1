{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - User & Staff Management{% endblock %}

{% block body %}
<div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <span>ADMIN AREA</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_home') }}">Home Site</a></li>
            <li><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
            <li><a href="{{ path('admin_customers') }}" class="active">Customers & Staff</a></li>
            <li><a href="{{ path('admin_bookings') }}">Bookings Manager</a></li>
            <li><a href="{{ path('app_booking') }}">New Booking</a></li>
            <li><a href="{{ path('app_logout') }}" class="logout-link">Log Out</a></li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main-content">
        <!-- Flash Notifications -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="admin-alert admin-alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="admin-header-flex">
            <div>
                <h1 class="admin-title">User & Staff Management</h1>
                <p class="admin-subtitle">Create, monitor, update roles, and manage access privileges across all accounts.</p>
            </div>
            <div class="header-action-group">
                <a href="{{ path('app_user_new') }}" class="admin-btn-primary">+ Create New Account</a>
                <div class="admin-stats-pill">
                    <span>Total Accounts: <strong>{{ users|length }}</strong></span>
                </div>
            </div>
        </div>

        <!-- Main Data Table Card -->
        <div class="admin-table-card">
            <div class="table-responsive">
                <table class="modern-admin-table">
                    <thead>
                        <tr>
                            <th># ID</th>
                            <th>Username</th>
                            <th>Email Address</th>
                            <th>Privilege Role</th>
                            <th>Date Created</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td class="id-col">#{{ user.id }}</td>
                                <td class="username-col">
                                    <div class="user-avatar-initial">{{ user.userIdentifier|slice(0, 2)|upper }}</div>
                                    <div>
                                        <span class="user-name-title">{{ user.username }}</span>
                                        {% if app.user and app.user.id == user.id %}
                                            <span class="badge badge-you">YOU</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td style="color: #cbd5e1;">{{ user.email }}</td>
                                <td>
                                    <div class="role-badges">
                                        {% for role in user.roles %}
                                            {% if role == 'ROLE_ADMIN' %}
                                                <span class="badge badge-admin">ADMIN</span>
                                            {% elseif role == 'ROLE_STAFF' %}
                                                <span class="badge badge-staff">STAFF</span>
                                            {% elseif role == 'ROLE_USER' and user.roles|length == 1 %}
                                                <span class="badge badge-user">CUSTOMER</span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                                <td style="color: #94a3b8; font-size: 13px;">
                                    {{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : 'Earlier' }}
                                </td>
                                <td class="text-right">
                                    <div class="action-buttons-inline">
                                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="action-btn-edit">Edit</a>
                                        
                                        {% if not app.user or app.user.id != user.id %}
                                            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to permanently delete account \'{{ user.username }}\'? This cannot be undone.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                                <button type="submit" class="action-btn-delete">Delete</button>
                                            </form>
                                        {% else %}
                                            <span class="action-locked-btn" title="Cannot delete active session">Protected</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="empty-state">No user accounts found in the database.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
.admin-layout {
    display: flex;
    min-height: 100vh;
    background-color: #080b11;
    color: #f8fafc;
    font-family: inherit;
}

.admin-sidebar {
    width: 260px;
    background: #0f172a;
    border-right: 1px solid rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-brand {
    padding: 24px;
    font-size: 16px;
    font-weight: 800;
    color: #00ffff;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-menu {
    list-style: none;
    padding: 20px 0;
    margin: 0;
}

.sidebar-menu li a {
    display: block;
    padding: 12px 24px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.sidebar-menu li a:hover, .sidebar-menu li a.active {
    background: rgba(0, 255, 255, 0.08);
    color: #00ffff;
    border-left: 3px solid #00ffff;
}

.sidebar-menu li a.logout-link {
    color: #f87171;
    margin-top: 40px;
}

.sidebar-menu li a.logout-link:hover {
    background: rgba(248, 113, 113, 0.1);
    border-left-color: #f87171;
}

.admin-main-content {
    flex: 1;
    padding: 40px;
    overflow-x: auto;
}

.admin-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

.admin-title {
    font-size: 26px;
    font-weight: 700;
    color: #00ffff;
    margin: 0 0 6px 0;
}

.admin-subtitle {
    color: #94a3b8;
    font-size: 14px;
    margin: 0;
}

.header-action-group {
    display: flex;
    align-items: center;
    gap: 14px;
}

.admin-btn-primary {
    background: #00ffff;
    color: #080b11;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
}

.admin-btn-primary:hover {
    background: #33ffff;
    transform: translateY(-2px);
}

.admin-stats-pill {
    background: #111827;
    border: 1px solid rgba(0, 255, 255, 0.2);
    padding: 10px 18px;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 13px;
}

.admin-stats-pill strong {
    color: #00ffff;
}

.admin-table-card {
    background: #111827;
    border: 1px solid rgba(0, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.modern-admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
}

.modern-admin-table th {
    background: #0f172a;
    color: #00ffff;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(0, 255, 255, 0.2);
}

.modern-admin-table td {
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    font-size: 14px;
}

.modern-admin-table tbody tr:hover {
    background: rgba(0, 255, 255, 0.03);
}

.id-col {
    color: #64748b;
    font-family: monospace;
}

.username-col {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
}

.user-name-title {
    font-weight: 700;
    color: #ffffff;
}

.user-avatar-initial {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 255, 255, 0.15);
    color: #00ffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
    border: 1px solid rgba(0, 255, 255, 0.3);
}

.role-badges {
    display: flex;
    gap: 6px;
}

.badge {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
}

.badge-admin {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
}

.badge-staff {
    background: rgba(167, 139, 250, 0.15);
    color: #a78bfa;
    border: 1px solid rgba(167, 139, 250, 0.3);
}

.badge-user {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
}

.badge-you {
    font-size: 10px;
    background: rgba(74, 222, 128, 0.2);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 6px;
}

.text-right {
    text-align: right;
}

.action-buttons-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.action-btn-edit {
    display: inline-block;
    background: rgba(0, 255, 255, 0.1);
    color: #00ffff;
    border: 1px solid rgba(0, 255, 255, 0.3);
    padding: 6px 14px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.action-btn-edit:hover {
    background: #00ffff;
    color: #080b11;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
}

.action-btn-delete {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.action-btn-delete:hover {
    background: #ef4444;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
}

.action-locked-btn {
    font-size: 12px;
    color: #64748b;
    padding: 6px 10px;
    border: 1px dashed #334155;
    border-radius: 6px;
}

.empty-state {
    text-align: center;
    padding: 40px !important;
    color: #64748b;
}

.admin-alert {
    padding: 12px 18px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: 600;
    font-size: 14px;
}

.admin-alert-success {
    background: rgba(74, 222, 128, 0.15);
    border: 1px solid #4ade80;
    color: #4ade80;
}

.admin-alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    color: #ef4444;
}
</style>
{% endblock %}
