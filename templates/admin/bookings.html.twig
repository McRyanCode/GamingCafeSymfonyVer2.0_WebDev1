{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Bookings Management{% endblock %}

{% block body %}
<div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <span>ADMIN GAMORA</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_home') }}">Home Site</a></li>
            <li><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
            <li><a href="{{ path('admin_customers') }}">Customers & Staff</a></li>
            <li><a href="{{ path('admin_bookings') }}" class="active">Bookings Manager</a></li>
            <li><a href="{{ path('app_booking') }}">New Booking</a></li>
            <li><a href="{{ path('app_logout') }}" class="logout-link">Log Out</a></li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main-content">
        <!-- Flash Notifications -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="admin-alert admin-alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="admin-header-flex">
            <div>
                <h1 class="admin-title">Station & Time Bookings</h1>
                <p class="admin-subtitle">Monitor user bookings, gaming tiers, active sessions, and update status.</p>
            </div>
            <div class="header-action-group">
                <a href="{{ path('app_booking') }}" class="admin-btn-primary">+ Add New Booking</a>
                <div class="admin-stats-pill">
                    <span>Total Bookings: <strong>{{ bookings|length }}</strong></span>
                </div>
            </div>
        </div>

        <!-- Bookings Data Table Card -->
        <div class="admin-table-card">
            <div class="table-responsive">
                <table class="modern-admin-table">
                    <thead>
                        <tr>
                            <th># ID</th>
                            <th>Customer / User</th>
                            <th>Station / Tier</th>
                            <th>Duration</th>
                            <th>Date / Time</th>
                            <th>Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for booking in bookings %}
                            <tr>
                                <td class="id-col">#{{ booking.id }}</td>
                                <td class="username-col">
                                    <div class="user-avatar-initial">{{ booking.user ? booking.user.userIdentifier|slice(0, 2)|upper : '??' }}</div>
                                    <span>{{ booking.user ? booking.user.userIdentifier : 'Unknown' }}</span>
                                </td>
                                <td>
                                    <strong>{{ booking.station ? booking.station.name : 'Station' }}</strong>
                                    <span class="badge badge-tier" style="margin-left: 6px;">{{ booking.tier }}</span>
                                </td>
                                <td style="font-weight: bold; color: #00ffff;">{{ booking.hours }} hrs</td>
                                <td style="color: #94a3b8;">{{ booking.bookingDate ? booking.bookingDate|date('Y-m-d H:i') : 'N/A' }}</td>
                                <td>
                                    {% if booking.status == 'CONFIRMED' %}
                                        <span class="badge badge-active">CONFIRMED</span>
                                    {% elseif booking.status == 'COMPLETED' %}
                                        <span class="badge badge-completed">COMPLETED</span>
                                    {% elseif booking.status == 'CANCELLED' %}
                                        <span class="badge badge-cancelled">CANCELLED</span>
                                    {% else %}
                                        <span class="badge badge-pending">{{ booking.status }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-right">
                                    <div class="action-buttons-inline">
                                        <!-- Quick Status Toggle Form -->
                                        <form method="post" action="{{ path('admin_booking_status', {'id': booking.id}) }}" style="display:inline-block;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('status_booking_' ~ booking.id) }}">
                                            {% if booking.status == 'CONFIRMED' %}
                                                <input type="hidden" name="status" value="COMPLETED">
                                                <button type="submit" class="action-btn-status complete" title="Mark as Completed">Complete</button>
                                            {% else %}
                                                <input type="hidden" name="status" value="CONFIRMED">
                                                <button type="submit" class="action-btn-status confirm" title="Reactivate Booking">Activate</button>
                                            {% endif %}
                                        </form>

                                        <!-- Delete Booking Form -->
                                        <form method="post" action="{{ path('admin_booking_delete', {'id': booking.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete booking #{{ booking.id }}?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_booking_' ~ booking.id) }}">
                                            <button type="submit" class="action-btn-delete">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="empty-state">No station bookings found in the database.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
.admin-layout {
    display: flex;
    min-height: 100vh;
    background-color: #080b11;
    color: #f8fafc;
    font-family: inherit;
}

.admin-sidebar {
    width: 260px;
    background: #0f172a;
    border-right: 1px solid rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-brand {
    padding: 24px;
    font-size: 16px;
    font-weight: 800;
    color: #00ffff;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-menu {
    list-style: none;
    padding: 20px 0;
    margin: 0;
}

.sidebar-menu li a {
    display: block;
    padding: 12px 24px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.sidebar-menu li a:hover, .sidebar-menu li a.active {
    background: rgba(0, 255, 255, 0.08);
    color: #00ffff;
    border-left: 3px solid #00ffff;
}

.sidebar-menu li a.logout-link {
    color: #f87171;
    margin-top: 40px;
}

.sidebar-menu li a.logout-link:hover {
    background: rgba(248, 113, 113, 0.1);
    border-left-color: #f87171;
}

.admin-main-content {
    flex: 1;
    padding: 40px;
    overflow-x: auto;
}

.admin-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

.admin-title {
    font-size: 26px;
    font-weight: 700;
    color: #00ffff;
    margin: 0 0 6px 0;
}

.admin-subtitle {
    color: #94a3b8;
    font-size: 14px;
    margin: 0;
}

.header-action-group {
    display: flex;
    align-items: center;
    gap: 14px;
}

.admin-btn-primary {
    background: #00ffff;
    color: #080b11;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
}

.admin-btn-primary:hover {
    background: #33ffff;
    transform: translateY(-2px);
}

.admin-stats-pill {
    background: #111827;
    border: 1px solid rgba(0, 255, 255, 0.2);
    padding: 10px 18px;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 13px;
}

.admin-stats-pill strong {
    color: #00ffff;
}

.admin-table-card {
    background: #111827;
    border: 1px solid rgba(0, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.modern-admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
}

.modern-admin-table th {
    background: #0f172a;
    color: #00ffff;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(0, 255, 255, 0.2);
}

.modern-admin-table td {
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    font-size: 14px;
}

.modern-admin-table tbody tr:hover {
    background: rgba(0, 255, 255, 0.03);
}

.id-col {
    color: #64748b;
    font-family: monospace;
}

.username-col {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
}

.user-avatar-initial {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 255, 255, 0.15);
    color: #00ffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
    border: 1px solid rgba(0, 255, 255, 0.3);
}

.badge {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
}

.badge-tier {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
}

.badge-active {
    background: rgba(74, 222, 128, 0.15);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
}

.badge-completed {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
}

.badge-cancelled {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.badge-pending {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
}

.text-right {
    text-align: right;
}

.action-buttons-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.action-btn-status {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
}

.action-btn-status.complete {
    background: rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    border: 1px solid rgba(148, 163, 184, 0.3);
}

.action-btn-status.complete:hover {
    background: #64748b;
    color: #ffffff;
}

.action-btn-status.confirm {
    background: rgba(74, 222, 128, 0.15);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
}

.action-btn-status.confirm:hover {
    background: #4ade80;
    color: #080b11;
}

.action-btn-delete {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
}

.action-btn-delete:hover {
    background: #ef4444;
    color: #ffffff;
}

.empty-state {
    text-align: center;
    padding: 40px !important;
    color: #64748b;
}

.admin-alert {
    padding: 12px 18px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: 600;
    font-size: 14px;
}

.admin-alert-success {
    background: rgba(74, 222, 128, 0.15);
    border: 1px solid #4ade80;
    color: #4ade80;
}

.admin-alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    color: #ef4444;
}
</style>
{% endblock %}
