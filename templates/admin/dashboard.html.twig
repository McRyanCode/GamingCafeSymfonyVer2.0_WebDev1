{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Gamora's Gaming Cafe{% endblock %}

{% block body %}
<div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <span>GAMORA ADMIN</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_home') }}">Home Site</a></li>
            <li><a href="{{ path('admin_dashboard') }}" class="active">Dashboard</a></li>
            <li><a href="{{ path('admin_customers') }}">Customers & Staff</a></li>
            <li><a href="{{ path('admin_bookings') }}">Bookings Manager</a></li>
            <li><a href="{{ path('app_booking') }}">New Booking</a></li>
            <li><a href="{{ path('app_logout') }}" class="logout-link">Log Out</a></li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main-content">
        <!-- Flash Notifications -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="admin-alert admin-alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Header -->
        <div class="admin-header-flex">
            <div>
                <h1 class="admin-title">System Overview & Analytics</h1>
                <p class="admin-subtitle">Real-time cafe metrics, station bookings, and staff management.</p>
            </div>
            <div class="header-action-group">
                <a href="{{ path('app_user_new') }}" class="admin-btn-primary">+ Create User / Staff</a>
                <a href="{{ path('app_booking') }}" class="admin-btn-secondary">+ Add Station Booking</a>
            </div>
        </div>

        <!-- Real-Time Stats Grid (Rubric Alignment: Total Users, Total Staff, Total Records/Bookings) -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon-wrapper cyan-glow">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00ffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Total Users / Gamers</span>
                    <h2 class="stat-number">{{ totalUsers }}</h2>
                    <span class="stat-hint">{{ totalCustomers }} Registered Customers</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrapper gold-glow">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Total Staff Members</span>
                    <h2 class="stat-number" style="color: #fbbf24;">{{ totalStaff }}</h2>
                    <span class="stat-hint">{{ totalAdmins }} Administrator(s)</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrapper green-glow">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Total Records / Bookings</span>
                    <h2 class="stat-number" style="color: #4ade80;">{{ totalBookings }}</h2>
                    <span class="stat-hint">{{ activeBookings }} Active / Confirmed</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrapper purple-glow">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Gaming Stations</span>
                    <h2 class="stat-number" style="color: #a78bfa;">{{ totalStations }}</h2>
                    <span class="stat-hint">PCs & Consoles Available</span>
                </div>
            </div>
        </div>

        <!-- Recent Activity Section -->
        <div class="admin-section-card">
            <div class="section-card-header">
                <div>
                    <h2 class="section-card-title">Recent Session Bookings</h2>
                    <p class="section-card-sub">Latest registered bookings and gaming stations reserved.</p>
                </div>
                <a href="{{ path('admin_bookings') }}" class="action-btn-view">View All Bookings →</a>
            </div>

            <div class="table-responsive">
                <table class="modern-admin-table">
                    <thead>
                        <tr>
                            <th># Booking</th>
                            <th>User / Gamer</th>
                            <th>Station / Tier</th>
                            <th>Duration</th>
                            <th>Date & Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for b in recentBookings %}
                            <tr>
                                <td class="id-col">#{{ b.id }}</td>
                                <td class="username-col">
                                    <div class="user-avatar-initial">{{ b.user.userIdentifier|slice(0, 2)|upper }}</div>
                                    <span>{{ b.user.userIdentifier }}</span>
                                </td>
                                <td>
                                    <strong>{{ b.station ? b.station.name : 'Station' }}</strong>
                                    <span class="badge badge-tier" style="margin-left: 6px;">{{ b.tier }}</span>
                                </td>
                                <td style="color: #00ffff; font-weight: 700;">{{ b.hours }} hr(s)</td>
                                <td style="color: #94a3b8;">{{ b.bookingDate ? b.bookingDate|date('Y-m-d H:i') : 'N/A' }}</td>
                                <td>
                                    {% if b.status == 'CONFIRMED' %}
                                        <span class="badge badge-active">CONFIRMED</span>
                                    {% elseif b.status == 'COMPLETED' %}
                                        <span class="badge badge-completed">COMPLETED</span>
                                    {% else %}
                                        <span class="badge badge-pending">{{ b.status }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="empty-state">No bookings recorded in system yet.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
.admin-layout {
    display: flex;
    min-height: 100vh;
    background-color: #080b11;
    color: #f8fafc;
    font-family: inherit;
}

.admin-sidebar {
    width: 260px;
    background: #0f172a;
    border-right: 1px solid rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-brand {
    padding: 24px;
    font-size: 16px;
    font-weight: 800;
    color: #00ffff;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-menu {
    list-style: none;
    padding: 20px 0;
    margin: 0;
}

.sidebar-menu li a {
    display: block;
    padding: 12px 24px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.sidebar-menu li a:hover, .sidebar-menu li a.active {
    background: rgba(0, 255, 255, 0.08);
    color: #00ffff;
    border-left: 3px solid #00ffff;
}

.sidebar-menu li a.logout-link {
    color: #f87171;
    margin-top: 40px;
}

.sidebar-menu li a.logout-link:hover {
    background: rgba(248, 113, 113, 0.1);
    border-left-color: #f87171;
}

.admin-main-content {
    flex: 1;
    padding: 40px;
    overflow-x: auto;
}

.admin-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 16px;
}

.admin-title {
    font-size: 26px;
    font-weight: 700;
    color: #00ffff;
    margin: 0 0 6px 0;
}

.admin-subtitle {
    color: #94a3b8;
    font-size: 14px;
    margin: 0;
}

.header-action-group {
    display: flex;
    gap: 12px;
}

.admin-btn-primary {
    background: #00ffff;
    color: #080b11;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
}

.admin-btn-primary:hover {
    background: #33ffff;
    transform: translateY(-2px);
}

.admin-btn-secondary {
    background: rgba(0, 255, 255, 0.1);
    color: #00ffff;
    border: 1px solid rgba(0, 255, 255, 0.3);
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
}

.admin-btn-secondary:hover {
    background: rgba(0, 255, 255, 0.2);
}

/* Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 35px;
}

.stat-card {
    background: #111827;
    border: 1px solid rgba(0, 255, 255, 0.15);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 18px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 255, 255, 0.4);
}

.stat-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.cyan-glow {
    background: rgba(0, 255, 255, 0.1);
    border: 1px solid rgba(0, 255, 255, 0.3);
}

.gold-glow {
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
}

.green-glow {
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.3);
}

.purple-glow {
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.3);
}

.stat-details {
    display: flex;
    flex-direction: column;
}

.stat-label {
    font-size: 12px;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

.stat-number {
    font-size: 28px;
    font-weight: 800;
    color: #00ffff;
    margin: 4px 0 2px 0;
    line-height: 1.1;
}

.stat-hint {
    font-size: 11px;
    color: #64748b;
}

/* Section Card */
.admin-section-card {
    background: #111827;
    border: 1px solid rgba(0, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.section-card-header {
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.section-card-title {
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
    margin: 0;
}

.section-card-sub {
    font-size: 12px;
    color: #94a3b8;
    margin: 4px 0 0 0;
}

.modern-admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
}

.modern-admin-table th {
    background: #0f172a;
    color: #00ffff;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(0, 255, 255, 0.2);
}

.modern-admin-table td {
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    font-size: 14px;
}

.modern-admin-table tbody tr:hover {
    background: rgba(0, 255, 255, 0.03);
}

.id-col {
    color: #64748b;
    font-family: monospace;
}

.username-col {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
}

.user-avatar-initial {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 255, 255, 0.15);
    color: #00ffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
    border: 1px solid rgba(0, 255, 255, 0.3);
}

.badge {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
}

.badge-tier {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
}

.badge-active {
    background: rgba(74, 222, 128, 0.15);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
}

.badge-completed {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
}

.badge-pending {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
}

.action-btn-view {
    display: inline-block;
    background: rgba(0, 255, 255, 0.1);
    color: #00ffff;
    border: 1px solid rgba(0, 255, 255, 0.3);
    padding: 6px 14px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.action-btn-view:hover {
    background: #00ffff;
    color: #080b11;
}

.empty-state {
    text-align: center;
    padding: 40px !important;
    color: #64748b;
}

.admin-alert {
    padding: 12px 18px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: 600;
    font-size: 14px;
}

.admin-alert-success {
    background: rgba(74, 222, 128, 0.15);
    border: 1px solid #4ade80;
    color: #4ade80;
}

.admin-alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    color: #ef4444;
}
</style>
{% endblock %}
