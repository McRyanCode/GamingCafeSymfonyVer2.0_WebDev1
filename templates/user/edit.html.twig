{% extends 'base.html.twig' %}

{% block title %}Edit User - Admin - Gamora's Gaming Cafe{% endblock %}

{% block body %}
<div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <span>GAMORA ADMIN</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_home') }}">Home Site</a></li>
            <li><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
            <li><a href="{{ path('admin_customers') }}" class="active">Customers & Staff</a></li>
            <li><a href="{{ path('admin_bookings') }}">Bookings Manager</a></li>
            <li><a href="{{ path('app_booking') }}">New Booking</a></li>
            <li><a href="{{ path('app_logout') }}" class="logout-link">Log Out</a></li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main-content">
        <div class="admin-header-flex">
            <div>
                <h1 class="admin-title">Edit Account: <span style="color:#ffffff;">{{ user.username }}</span></h1>
                <p class="admin-subtitle">Update usernames, contact emails, assigned privilege roles, or reset account password.</p>
            </div>
            <a href="{{ path('admin_customers') }}" class="admin-btn-secondary">← Back to Accounts</a>
        </div>

        {{ include('user/_form.html.twig', {'button_label': 'Update Account'}) }}
    </main>
</div>

<style>
.admin-layout {
    display: flex;
    min-height: 100vh;
    background-color: #080b11;
    color: #f8fafc;
    font-family: inherit;
}

.admin-sidebar {
    width: 260px;
    background: #0f172a;
    border-right: 1px solid rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-brand {
    padding: 24px;
    font-size: 16px;
    font-weight: 800;
    color: #00ffff;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-menu {
    list-style: none;
    padding: 20px 0;
    margin: 0;
}

.sidebar-menu li a {
    display: block;
    padding: 12px 24px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.sidebar-menu li a:hover, .sidebar-menu li a.active {
    background: rgba(0, 255, 255, 0.08);
    color: #00ffff;
    border-left: 3px solid #00ffff;
}

.sidebar-menu li a.logout-link {
    color: #f87171;
    margin-top: 40px;
}

.sidebar-menu li a.logout-link:hover {
    background: rgba(248, 113, 113, 0.1);
    border-left-color: #f87171;
}

.admin-main-content {
    flex: 1;
    padding: 40px;
    overflow-x: auto;
}

.admin-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

.admin-title {
    font-size: 26px;
    font-weight: 700;
    color: #00ffff;
    margin: 0 0 6px 0;
}

.admin-subtitle {
    color: #94a3b8;
    font-size: 14px;
    margin: 0;
}

.admin-btn-secondary {
    background: rgba(0, 255, 255, 0.1);
    color: #00ffff;
    border: 1px solid rgba(0, 255, 255, 0.3);
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
}

.admin-btn-secondary:hover {
    background: rgba(0, 255, 255, 0.2);
}
</style>
{% endblock %}
