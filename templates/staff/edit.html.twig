{% extends 'base.html.twig' %}

{% block title %}Edit Session Record #{{ booking.id }} - Staff - Gamora's Gaming Cafe{% endblock %}

{% block body %}
<div class="admin-layout">
    <!-- Staff Sidebar Navigation -->
    <aside class="admin-sidebar staff-sidebar-accent">
        <div class="sidebar-brand">
            <span style="color: #a78bfa;">STAFF AREA</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_home') }}">Home Site</a></li>
            <li><a href="{{ path('staff_dashboard') }}" class="active">Staff Dashboard</a></li>
            <li><a href="{{ path('staff_record_new') }}">Create Record</a></li>
            <li><a href="{{ path('app_booking') }}">Client Booking</a></li>
            {% if is_granted('ROLE_ADMIN') %}
                <li><a href="{{ path('admin_dashboard') }}" style="color: #fbbf24;">Admin Panel</a></li>
            {% endif %}
            <li><a href="{{ path('app_logout') }}" class="logout-link">Log Out</a></li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main-content">
        <div class="admin-header-flex">
            <div>
                <h1 class="admin-title" style="color: #a78bfa;">Edit Record #{{ booking.id }}</h1>
                <p class="admin-subtitle">Updating your staff-created record. Modifying status, duration, and assigned station.</p>
            </div>
            <a href="{{ path('staff_dashboard') }}" class="staff-btn-secondary">← Back to Records</a>
        </div>

        <div class="record-form-card">
            {{ form_start(form, {'attr': {'class': 'modern-form'}}) }}
                {{ form_errors(form) }}

                <div class="form-row">
                    <div class="form-field-group">
                        <label class="form-label" for="{{ form.tier.vars.id }}">Gaming Tier / Package <span class="required-star">*</span></label>
                        {{ form_widget(form.tier) }}
                        {{ form_errors(form.tier) }}
                    </div>

                    <div class="form-field-group">
                        <label class="form-label" for="{{ form.station.vars.id }}">Station Rig (Optional)</label>
                        {{ form_widget(form.station) }}
                        {{ form_errors(form.station) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field-group">
                        <label class="form-label" for="{{ form.bookingDate.vars.id }}">Session Date <span class="required-star">*</span></label>
                        {{ form_widget(form.bookingDate) }}
                        {{ form_errors(form.bookingDate) }}
                    </div>

                    <div class="form-field-group">
                        <label class="form-label" for="{{ form.startTime.vars.id }}">Start Time <span class="required-star">*</span></label>
                        {{ form_widget(form.startTime) }}
                        {{ form_errors(form.startTime) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field-group">
                        <label class="form-label" for="{{ form.hours.vars.id }}">Duration in Hours <span class="required-star">*</span></label>
                        {{ form_widget(form.hours) }}
                        {{ form_errors(form.hours) }}
                    </div>

                    <div class="form-field-group">
                        <label class="form-label" for="{{ form.status.vars.id }}">Record Status <span class="required-star">*</span></label>
                        {{ form_widget(form.status) }}
                        {{ form_errors(form.status) }}
                    </div>
                </div>

                <div class="form-actions-bar">
                    <a href="{{ path('staff_dashboard') }}" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save-staff-record">Update Record</button>
                </div>
            {{ form_end(form) }}
        </div>
    </main>
</div>

<style>
.admin-layout {
    display: flex;
    min-height: 100vh;
    background-color: #080b11;
    color: #f8fafc;
    font-family: inherit;
}

.staff-sidebar-accent {
    border-right-color: rgba(167, 139, 250, 0.2) !important;
}

.admin-sidebar {
    width: 260px;
    background: #0f172a;
    border-right: 1px solid rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-brand {
    padding: 24px;
    font-size: 16px;
    font-weight: 800;
    color: #00ffff;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-menu {
    list-style: none;
    padding: 20px 0;
    margin: 0;
}

.sidebar-menu li a {
    display: block;
    padding: 12px 24px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.sidebar-menu li a:hover, .sidebar-menu li a.active {
    background: rgba(167, 139, 250, 0.1);
    color: #a78bfa;
    border-left: 3px solid #a78bfa;
}

.sidebar-menu li a.logout-link {
    color: #f87171;
    margin-top: 40px;
}

.sidebar-menu li a.logout-link:hover {
    background: rgba(248, 113, 113, 0.1);
    border-left-color: #f87171;
}

.admin-main-content {
    flex: 1;
    padding: 40px;
    overflow-x: auto;
}

.admin-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

.admin-title {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 6px 0;
}

.admin-subtitle {
    color: #94a3b8;
    font-size: 14px;
    margin: 0;
}

.staff-btn-secondary {
    background: rgba(167, 139, 250, 0.1);
    color: #a78bfa;
    border: 1px solid rgba(167, 139, 250, 0.3);
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
}

.staff-btn-secondary:hover {
    background: rgba(167, 139, 250, 0.2);
}

.record-form-card {
    background: #111827;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 12px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    max-width: 800px;
}

.modern-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
}

.form-field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-label {
    font-size: 13px;
    font-weight: 700;
    color: #a78bfa;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.required-star {
    color: #ef4444;
}

.admin-input, .admin-select {
    background-color: #080b11 !important;
    border: 1px solid rgba(167, 139, 250, 0.25) !important;
    border-radius: 8px !important;
    padding: 12px 16px !important;
    color: #ffffff !important;
    font-size: 14px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    outline: none !important;
    transition: all 0.2s ease !important;
}

.admin-input:focus, .admin-select:focus {
    border-color: #a78bfa !important;
    box-shadow: 0 0 10px rgba(167, 139, 250, 0.3) !important;
}

.form-actions-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.btn-cancel {
    padding: 10px 20px;
    color: #94a3b8;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 13px;
    transition: all 0.2s ease;
}

.btn-cancel:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
}

.btn-save-staff-record {
    background: #a78bfa;
    color: #080b11;
    border: none;
    padding: 12px 28px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(167, 139, 250, 0.3);
    transition: all 0.2s ease;
}

.btn-save-staff-record:hover {
    background: #c4b5fd;
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.5);
}
</style>
{% endblock %}
