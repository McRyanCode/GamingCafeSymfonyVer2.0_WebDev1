
{% extends 'base.html.twig' %}

{% block title %}Sign in to Gamora's - Gamora's Gaming Cafe{% endblock %}

{% block body %}
<div class="auth-page-wrapper">
    <div class="auth-card">

        <div class="auth-card-header">
            <a href="{{ path('app_home') }}" class="auth-close-btn">×</a>

            <div class="auth-logo-only">
                <img src="{{ asset('image_GamingCafe/Logo.png') }}" alt="Gamora's Gaming Cafe Logo">
            </div>

            <h2>Sign in  <span class="cyan-text">Gamer</span></h2>
        </div>

        {% if error %}
            <div class="alert alert-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="POST" class="auth-form">

            <div class="form-group">
                <label for="username">Username</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    class="form-input"
                    value="{{ last_username }}"
                    autocomplete="username"
                    required
                >
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label for="password">Password</label>
                    <a href="{{ path('app_forgot_password') }}" class="forgot-link">Forgot password?</a>
                </div>

                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-input"
                    autocomplete="current-password"
                    required
                >
            </div>

            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit" class="btn-submit-auth">
                Sign in
            </button>

        </form>

        <div class="auth-divider"></div>

        <p class="auth-switch-text">
            New to the Cafe?
            <a href="{{ path('app_register') }}">Create an account</a>
        </p>

    </div>
</div>
{% endblock %}
