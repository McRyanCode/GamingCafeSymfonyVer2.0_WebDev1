{% extends 'base.html.twig' %}

{% block title %}Reset Password - Gamora's Gaming Cafe{% endblock %}

{% block body %}
<div class="auth-page-wrapper">
    <div class="auth-card">

        <div class="auth-card-header">
            <a href="{{ path('app_login') }}" class="auth-close-btn">×</a>

            <div class="auth-logo-only">
                <img src="{{ asset('image_GamingCafe/Logo.png') }}" alt="Gamora's Gaming Cafe Logo">
            </div>

            <h2>Forgot Your <span class="cyan-text">Password?</span></h2>
            <p style="color: #94a3b8; font-size: 13px; margin: 6px 0 0 0;">For account safety, password recovery must be handled by a cafe administrator.</p>
        </div>

        <div class="auth-form">
            <p style="color: #cbd5e1; font-size: 14px; line-height: 1.6;">
                Please contact the cafe administrator to reset your password. An administrator can verify your identity and reset it from account management.
            </p>
        </div>

        <div class="auth-divider"></div>

        <p class="auth-switch-text">
            Remembered your password?
            <a href="{{ path('app_login') }}">Sign In</a>
        </p>

    </div>
</div>
{% endblock %}
