{% extends 'base.html.twig' %}

{% block title %}Reset Password - Gamora's Gaming Cafe{% endblock %}

{% block body %}
<div class="auth-page-wrapper">
    <div class="auth-card">

        <div class="auth-card-header">
            <a href="{{ path('app_login') }}" class="auth-close-btn">×</a>

            <div class="auth-logo-only">
                <img src="{{ asset('image_GamingCafe/Logo.png') }}" alt="Gamora's Gaming Cafe Logo">
            </div>

            <h2>Reset Your <span class="cyan-text">Password</span></h2>
            <p style="color: #94a3b8; font-size: 13px; margin: 6px 0 0 0;">Enter your username and email to verify your account and set a new password.</p>
        </div>

        {% if error %}
            <div class="alert alert-error" style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #ef4444; padding: 12px; border-radius: 6px; font-size: 13px; margin-bottom: 20px;">
                {{ error }}
            </div>
        {% endif %}

        <form action="{{ path('app_forgot_password') }}" method="POST" class="auth-form">

            <div class="form-group">
                <label for="identifier">Username</label>
                <input
                    type="text"
                    id="identifier"
                    name="identifier"
                    class="form-input"
                    placeholder="Enter your registered username"
                    autocomplete="username"
                    required
                >
            </div>

            <div class="form-group">
                <label for="email">Email Address</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-input"
                    placeholder="Enter your registered email"
                    autocomplete="email"
                    required
                >
            </div>

            <div class="form-group">
                <label for="new_password">New Password</label>
                <input
                    type="password"
                    id="new_password"
                    name="new_password"
                    class="form-input"
                    placeholder="Enter new password (min. 6 characters)"
                    autocomplete="new-password"
                    required
                >
            </div>

            <div class="form-group">
                <label for="confirm_password">Confirm New Password</label>
                <input
                    type="password"
                    id="confirm_password"
                    name="confirm_password"
                    class="form-input"
                    placeholder="Re-enter your new password"
                    autocomplete="new-password"
                    required
                >
            </div>

            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('forgot_password') }}"
            >

            <button type="submit" class="btn-submit-auth">
                Reset Password
            </button>

        </form>

        <div class="auth-divider"></div>

        <p class="auth-switch-text">
            Remembered your password?
            <a href="{{ path('app_login') }}">Sign In</a>
        </p>

    </div>
</div>
{% endblock %}
